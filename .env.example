# Cấu hình tùy chọn cho Moodle Greenwich Crawler
# Nếu để trống, crawler sẽ tự động trích xuất cookie từ Firefox Profile đang mở

MOODLE_BASE_URL=https://moodlecurrent.gre.ac.uk
OUTPUTS_DIR=outputs
REQUEST_TIMEOUT=30
REQUEST_DELAY=0.5

# Nếu muốn chỉ định thủ công cookie MoodleSession (không cần Firefox)
MOODLE_SESSION=
